# COAMO · variables de entorno del frontend (Vite).
# Copiar a .env (no versionado). COAMO comparte proyecto Supabase con DERMAPEX: mismos valores.
# Solo la clave PÚBLICA (anon/publishable). NUNCA la service-role key en el frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Opcional, solo en build: ruta base de publicación (por defecto '/').
# COAMO_BASE_PATH=/COAMO/
